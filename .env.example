# Copy file nay thanh .env va dien gia tri thuc
# KHONG commit .env vao git!

# GitHub stores source/config; GHCR stores ARM64 images. No credentials here.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=
IMAGE_TAG=dev-ai-tracking-flow
EXPECTED_BRANCH=dev/ai_tracking_flow
BUILDER=drone-builder
# Optional repository URL label: https://github.com/OWNER/REPOSITORY
IMAGE_SOURCE_URL=
DRONE_RUNTIME_DIR=./runtime

# Luon dung hostname mDNS; wlan0 co the doi IP DHCP.
PI_HOST=drone.local
PI_USER=thong
DRONE_SERIAL_PORT=/dev/ttyAMA4
DRONE_BAUD_RATE=921600
CAMERA_DEVICE=/dev/video0
ROS_DOMAIN_ID=0
LOG_LEVEL=INFO
GCS_IP=
TCP_SERVER_PORT=5760

MDNS_HOSTNAME=drone
