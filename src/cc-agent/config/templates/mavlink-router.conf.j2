# ==============================================================================
# Auto-generated by cc-configd from config.yaml
# DO NOT EDIT DIRECTLY. Source of truth is configs/config.yaml
# ==============================================================================

[General]
ReportStats = true
MavlinkDialect = ardupilotmega
DebugLogLevel = info
TcpServerPort = 0

{% if hardware.uart4.enabled %}
[UartEndpoint FlightController]
Device = /dev/ttyAMA4
Baud = {{ hardware.uart4.baudrate | default(921600) }}
FlowControl = false
{% endif %}

{% if hardware.uart0.enabled %}
[UartEndpoint SIYI_Serial]
Device = /dev/ttyAMA0
Baud = {{ hardware.uart0.baudrate | default(115200) }}
FlowControl = false
{% endif %}

[UdpEndpoint QGC_UDP_Server]
Mode = Server
Address = 0.0.0.0
Port = {{ network.gcs_port | default(14550) }}

[UdpEndpoint MAVROS_Companion]
Mode = Server
Address = 127.0.0.1
Port = 14541

[UdpEndpoint Internal_Companion]
Mode = Server
Address = 127.0.0.1
Port = 14540

[UdpEndpoint ConfigAgent]
Mode = Server
Address = 127.0.0.1
Port = 14600
