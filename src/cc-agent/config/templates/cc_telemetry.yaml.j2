# ==============================================================================
# Auto-generated by cc-configd from config.yaml
# DO NOT EDIT DIRECTLY. Source of truth is configs/config.yaml
# ==============================================================================

allow_remote_writes: true
state_directory: {{ paths.state_dir | default('/run/drone/state') }}
camera_config: {{ paths.configs_dir | default('/etc/cc-sources') }}/camera.yaml
vision_config: {{ paths.configs_dir | default('/etc/cc-sources') }}/vision.yaml
hostapd_config: {{ paths.configs_dir | default('/etc/cc-sources') }}/hostapd.conf
rtsp_url: rtsp://127.0.0.1:{{ network.rtsp_port | default(8554) }}/live/main

rates:
  links: 1.0
  camera: 0.2
  network: 0.2
  vision: 1.0

qgc_log:
  socket_path: /tmp/qgc_log.sock
  max_msg_per_sec: 5
  max_msg_len: 50
  min_severity: 6
