# syntax=docker/dockerfile:1
FROM --platform=linux/arm64 ros:jazzy-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake build-essential pkg-config \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libyaml-cpp-dev \
    ros-jazzy-librealsense2 \
    && rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_PATH=/opt/ros/jazzy/lib/aarch64-linux-gnu/pkgconfig
ENV CMAKE_PREFIX_PATH=/opt/ros/jazzy

WORKDIR /app
COPY src/drivers/camera/ /app/src/drivers/camera/
COPY src/modules/camera_streamer/ /app/src/modules/camera_streamer/
WORKDIR /app/src/modules/camera_streamer

RUN mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    make -j$(nproc) && \
    make install

# Export stage copies only the compiled binary to the host
FROM scratch AS export
COPY --from=builder /usr/local/bin/drone_camera_streamer /
