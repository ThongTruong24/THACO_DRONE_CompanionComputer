<?xml version="1.0" encoding="UTF-8" ?>
<!-- DDS chỉ trên lo, discovery unicast (lo thường không có cờ MULTICAST; kiểm lại trên Pi). Không RTPS ra uap0/wlan0/eth0. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="lo" multicast="false"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
      <Peers><Peer address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
