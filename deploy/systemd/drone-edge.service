[Unit]
Description=Drone Edge Computing Service (MAVLink + RealSense + RTSP)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/thong/drone-edge
ExecStart=/usr/bin/docker compose up -d --no-build --pull never
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
