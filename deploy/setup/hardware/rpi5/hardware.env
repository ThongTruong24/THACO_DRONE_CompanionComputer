# ==============================================================================
# Hardware Profile: Raspberry Pi 5 (RP1 I/O Controller)
# ==============================================================================
HARDWARE_PROFILE=rpi5

# Serial UART Configuration
# Note: On Pi 5, UART4 is on GPIO 8/9, UART0 is on GPIO 14/15 (via dtoverlay=uart0-pi5)
DRONE_SERIAL_PORT=/dev/ttyAMA4
DRONE_BAUD_RATE=921600
SIYI_SERIAL_PORT=/dev/ttyAMA0
SIYI_BAUD=115200

# Video Encoder: Software ARM NEON (Pi 5 has no H.264 HW block, relies on high-speed Cortex-A76 NEON)
CAMERA_ENCODER=sw_neon
CAMERA_DEVICE=/dev/video0
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=30
STREAM_BITRATE=1500

# AI Vision Inference Profile
VISION_INFERENCE_BACKEND=cpu_neon
VISION_NPU_ENABLED=false
