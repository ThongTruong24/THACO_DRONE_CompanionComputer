# ==============================================================================
# Hardware Profile: NVIDIA Jetson (Orin Nano / NX / Xavier)
# ==============================================================================
HARDWARE_PROFILE=jetson

# Serial UART Configuration
# Note: On Jetson 40-pin header, UART1 is /dev/ttyTHS1, UART2 is /dev/ttyTHS2
DRONE_SERIAL_PORT=/dev/ttyTHS1
DRONE_BAUD_RATE=921600
SIYI_SERIAL_PORT=/dev/ttyTHS2
SIYI_BAUD=115200

# Video Encoder: NVIDIA Hardware NVENC (nvv4l2h264enc)
CAMERA_ENCODER=nvenc
CAMERA_DEVICE=/dev/video0
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=30
STREAM_BITRATE=1500

# AI Vision Inference Profile
VISION_INFERENCE_BACKEND=tensorrt
VISION_NPU_ENABLED=true
