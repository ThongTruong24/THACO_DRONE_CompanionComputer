# ==============================================================================
# Hardware Profile: Raspberry Pi 4B (BCM2711 SoC)
# ==============================================================================
HARDWARE_PROFILE=rpi4

# Serial UART Configuration
# Note: On Pi 4B, PL011 UART0 is on GPIO 14/15 (/dev/ttyAMA0) by default with enable_uart=1.
# UART4 is enabled via dtoverlay=uart4 on GPIO 8/9 (/dev/ttyAMA4).
DRONE_SERIAL_PORT=/dev/ttyAMA4
DRONE_BAUD_RATE=921600
SIYI_SERIAL_PORT=/dev/ttyAMA0
SIYI_BAUD=115200

# Video Encoder: Hardware V4L2 M2M (BCM2711 has dedicated hardware H.264 encoder on /dev/video11)
CAMERA_ENCODER=v4l2m2m
CAMERA_DEVICE=/dev/video0
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=30
STREAM_BITRATE=1500

# AI Vision Inference Profile
VISION_INFERENCE_BACKEND=cpu_neon
VISION_NPU_ENABLED=false
