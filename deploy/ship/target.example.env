# ==============================================================================
# Drone Hardware Target Configuration
# Sử dụng cho cơ chế tự động phân giải Target Host (DNS/mDNS vs Fallback IP)
# ==============================================================================

# Tên miền mDNS phát bởi avahi trong container edge-network
TARGET_MDNS=drone.local

# IP dự phòng khi Drone chưa lên mDNS hoặc mạng không hỗ trợ Multicast DNS
TARGET_FALLBACK_IP=10.14.95.6

# User SSH trên Companion Computer
TARGET_USER=thong

# Thư mục chứa project trên Companion Computer
TARGET_REMOTE_DIR=~/drone-edge
